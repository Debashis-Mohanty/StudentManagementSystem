@model IEnumerable<DfaCRUDApplication.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1 class="justify-content-center">Student Details</h1>

<p>
    <a class="btn btn-success" asp-action="Create">Add New Student</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Sname)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SGender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SDob)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Sname)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SGender)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SDob)
            </td>
            <td>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Sid">Edit</a> |
                <a class="btn btn-warning" asp-action="Details" asp-route-id="@item.Sid">Details</a> |
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Sid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
