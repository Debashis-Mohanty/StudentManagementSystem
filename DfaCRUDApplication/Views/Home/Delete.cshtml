@model DfaCRUDApplication.Models.Student

@{
    ViewData["Title"] = "Delete";
}

<h1 class="justify-content-center">Delete Student</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Student Detials</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Sname)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Sname)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SEmail)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SEmail)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SGender)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SGender)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SDob)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SDob)
