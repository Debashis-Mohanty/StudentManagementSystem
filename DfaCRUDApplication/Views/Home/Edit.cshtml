@model DfaCRUDApplication.Models.Student

@{
    ViewData["Title"] = "Edit";
}

<h1 class="justify-content-center">Edit Student</h1>

<hr />
<div class="row justify-content-center">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Sid" />
            <div class="form-group">
                <label asp-for="Sname" class="control-label"></label>
                <input asp-for="Sname" class="form-control" />
                <span asp-validation-for="Sname" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SEmail" class="control-label"></label>
                <input asp-for="SEmail" class="form-control" />
                <span asp-validation-for="SEmail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SGender" class="control-label"></label>
                <input asp-for="SGender" class="form-control" />
                <span asp-validation-for="SGender" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SDob" class="control-label"></label>
                <input asp-for="SDob" class="form-control" />
                <span asp-validation-for="SDob" class="text-danger"></span>
            </div><br />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a class="btn btn-dark text-white" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
